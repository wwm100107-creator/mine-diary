rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. Users Collection ──────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── 2. Relationships Collection (Friendships / Couples) ─────────
    match /relationships/{relId} {
      allow read, write: if true;
    }

    // ── 3. Chats & Messages Collection ───────────────────────────────
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ── 4. Cycle Data & Health Logs ──────────────────────────────────
    match /cycleData/{userId} {
      allow read, write: if true;
    }

    // ── 5. System Notifications & Push Tokens ────────────────────────
    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }
  }
}

